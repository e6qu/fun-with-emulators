/* Generated by tools/x18forms/gen.py from the lists in tools/x18forms.
 *
 * Every instruction naming x18 that the real binaries listed there hold,
 * run as it is and checked against the same instruction with x18 renamed
 * to a register it does not use (run as it is): first in the program's
 * code (fwe rewrites it, as it rewrites the binary's), then copied into
 * memory made executable at run time (fwe runs it by translation, as it
 * runs a JIT's code or a page of a binary its stubs do not serve). Both
 * copies start from the same registers, flags, stack and memory, from
 * several starting states, and are checked to end the same: registers,
 * flags, stack pointer, memory, and whether the instruction faulted. Linux
 * lets a program use x18 like any register, so on Linux both copies always
 * agree; the lines printed are what Linux prints. */
#include <stddef.h>
#include <stdint.h>

int printf(const char *fmt, ...);
void *memcpy(void *d, const void *s, size_t n);
int memcmp(const void *a, const void *b, size_t n);
void *mmap(void *addr, size_t len, int prot, int flags, int fd, long off);
int mprotect(void *addr, size_t len, int prot);

struct sigaction {
    void (*sa_sigaction)(int, void *, void *);
    unsigned long sa_mask[16];
    int sa_flags;
    void (*sa_restorer)(void);
};
int sigaction(int sig, const struct sigaction *act, struct sigaction *old);

/* musl's, for aarch64. */
typedef struct {
    unsigned long jb[22];
    unsigned long fl;
    unsigned long ss[16];
} sigjmp_buf[1];
__attribute__((returns_twice)) int sigsetjmp(sigjmp_buf env, int savemask);
__attribute__((noreturn)) void siglongjmp(sigjmp_buf env, int val);

#define PROT_READ 1
#define PROT_WRITE 2
#define PROT_EXEC 4
#define MAP_PRIVATE 2
#define MAP_ANONYMOUS 0x20
#define SIGBUS 7
#define SIGSEGV 11
#define SA_SIGINFO 4
#define SA_NODEFER 0x40000000

/* What a copy runs from and leaves: x0-x30 (x29 and x30 untouched), the
 * flags, its stack pointer, the caller's (kept by the copy), and the
 * memory its registers point into, with its stack at the memory's top. */
struct state {
    uint64_t x[31];
    uint64_t nzcv;
    uint64_t sp;
    uint64_t caller_sp;
};
_Static_assert(offsetof(struct state, nzcv) == 248, "the generator's layout");
_Static_assert(offsetof(struct state, sp) == 256, "the generator's layout");

#define MEM (1 << 16)

typedef void (*copy_fn)(struct state *);

struct entry {
    copy_fn a, b;
    /* `a`'s instructions as data, from the start to the end. */
    const char *code, *code_end;
    const char *text;
};

@DECLS@

__asm__(".text\n"
        ".balign 16\n"
@ASM@
);

static const struct entry entries[] = {
@TABLE@
};

static sigjmp_buf back;

static void on_fault(int sig, void *si, void *ctx) {
    (void)si;
    (void)ctx;
    siglongjmp(back, sig);
}

/* Run `copy` from `start` on `mem` (a copy of `image`): what it left, or
 * the signal it faulted with. */
static int run(copy_fn copy, const struct state *start, struct state *end, char *mem,
               const char *image) {
    memcpy(mem, image, MEM);
    *end = *start;
    int sig = sigsetjmp(back, 1);
    if (sig == 0) {
        copy(end);
    }
    return sig;
}

static uint64_t next = 0x9e3779b97f4a7c15ull;

static uint64_t random64(void) {
    next ^= next << 13;
    next ^= next >> 7;
    next ^= next << 17;
    return next;
}

/* A starting state: registers pointing into the memory, small numbers,
 * or anything, with flags. */
static void starting(struct state *s, char *mem, int kind) {
    for (int r = 0; r < 31; r++) {
        uint64_t v = random64();
        switch (kind) {
        case 0:
            s->x[r] = (uint64_t)mem + MEM / 4 + (v & 0x3ff8);
            break;
        case 1:
            s->x[r] = v & 0x3f;
            break;
        default:
            s->x[r] = v;
        }
    }
    s->nzcv = (random64() & 0xf) << 28;
    s->sp = ((uint64_t)mem + MEM - 4096) & ~15ull;
}

/* Each entry's word run as `a` is, against its renamed copy: how many
 * differ, the first of them printed. */
static int compare(copy_fn const *a, char *mem, const char *image, char *after_a) {
    int count = (int)(sizeof entries / sizeof entries[0]), differ = 0;
    for (int i = 0; i < count; i++) {
        for (int kind = 0; kind < 3; kind++) {
            for (int round = 0; round < 4; round++) {
                struct state start, sa, sb;
                starting(&start, mem, kind);
                int fa = run(a[i], &start, &sa, mem, image);
                memcpy(after_a, mem, MEM);
                int fb = run(entries[i].b, &start, &sb, mem, image);
                int same = fa == fb;
                if (same && !fa) {
                    /* Memory below the stack pointer is not live (Linux has
                     * no red zone): what a copy leaves there is its own. */
                    size_t below = start.sp - (uint64_t)mem - 4096;
                    same = memcmp(sa.x, sb.x, sizeof sa.x) == 0 && sa.nzcv == sb.nzcv &&
                           sa.sp == sb.sp && memcmp(after_a, mem, below) == 0 &&
                           memcmp(after_a + below + 4096, mem + below + 4096,
                                  MEM - below - 4096) == 0;
                }
                if (!same) {
                    /* Not printed on Linux, where the copies always agree. */
                    if (differ < 20) {
                        printf("differs: #%d %s (kind %d): fault %d vs %d", i, entries[i].text, kind, fa,
                               fb);
                        for (int r = 0; r < 31; r++) {
                            if (sa.x[r] != sb.x[r]) {
                                printf("; x%d %lx vs %lx", r, (unsigned long)sa.x[r],
                                       (unsigned long)sb.x[r]);
                            }
                        }
                        if (sa.nzcv != sb.nzcv) {
                            printf("; nzcv %lx vs %lx", (unsigned long)sa.nzcv,
                                   (unsigned long)sb.nzcv);
                        }
                        if (sa.sp != sb.sp) {
                            printf("; sp %lx vs %lx", (unsigned long)sa.sp, (unsigned long)sb.sp);
                        }
                        printf("\n");
                    }
                    differ++;
                    goto next_entry;
                }
            }
        }
    next_entry:;
    }
    return differ;
}

int main(void) {
    struct sigaction sa = {0};
    sa.sa_sigaction = on_fault;
    sa.sa_flags = SA_SIGINFO | SA_NODEFER;
    sigaction(SIGSEGV, &sa, 0);
    sigaction(SIGBUS, &sa, 0);
    char *mem = mmap(0, MEM, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    static char image[MEM], after_a[MEM];
    for (int i = 0; i < MEM; i++) {
        image[i] = (char)random64();
    }
    enum { COUNT = sizeof entries / sizeof entries[0] };
    static copy_fn in_text[COUNT], made[COUNT];
    size_t size = 0;
    for (int i = 0; i < COUNT; i++) {
        in_text[i] = entries[i].a;
        size += (size_t)(entries[i].code_end - entries[i].code);
    }
    /* The words' own copies, written into memory then made executable. */
    char *code = mmap(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    for (size_t at = 0, i = 0; i < COUNT; i++) {
        size_t n = (size_t)(entries[i].code_end - entries[i].code);
        memcpy(code + at, entries[i].code, n);
        made[i] = (copy_fn)(void *)(code + at);
        at += n;
    }
    /* Written for data, then cleaned to the point of unification and the
     * instruction cache's copies dropped, as the architecture asks. */
    for (char *p = code; p < code + size; p += 4) {
        __asm__ volatile("dc cvau, %0" ::"r"(p) : "memory");
    }
    __asm__ volatile("dsb ish" ::: "memory");
    for (char *p = code; p < code + size; p += 4) {
        __asm__ volatile("ic ivau, %0" ::"r"(p) : "memory");
    }
    __asm__ volatile("dsb ish\n isb" ::: "memory");
    mprotect(code, size, PROT_READ | PROT_EXEC);
    int differ = compare(in_text, mem, image, after_a);
    printf("x18 instructions: %d of %d alike\n", COUNT - differ, COUNT);
    differ = compare(made, mem, image, after_a);
    printf("x18 instructions made at run time: %d of %d alike\n", COUNT - differ, COUNT);
    return 0;
}
